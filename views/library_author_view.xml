<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        
        <!-- ============================================ -->
        <!-- VUE FORMULAIRE AUTEUR                        -->
        <!-- ============================================ -->
        <record id="view_library_author_form" model="ir.ui.view">
            <field name="name">library.author.form</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <form string="Auteur">
                    <sheet>
                        <!-- 2 colonnes de champs -->
                        <group>
                            <group>
                                <field name="name" />
                                <field name="nationality" />
                                <field name="birth_date" />
                            </group>
                            <group>
                                <field name="pseudonym" />
                                <field name="book_count" />
                            </group>
                        </group>

                        <!-- Biographie sur toute la largeur -->
                        <group string="Biographie">
                            <field name="biography" nolabel="1" />
                        </group>

                        <!-- Onglet listant les livres de l'auteur -->
                        <notebook>
                            <page string="Livres écrits">
                                <field name="book_ids">
                                    <tree>
                                        <field name="name" />
                                        <field name="publication_date" />
                                        <field name="state" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- VUE LISTE (TREE) AUTEUR                      -->
        <!-- ============================================ -->
        <record id="view_library_author_tree" model="ir.ui.view">
            <!-- Nom technique de la vue (convention : modele.type) -->
            <field name="name">library.author.tree</field>
            <!-- Modèle auquel la vue s'applique -->
            <field name="model">library.author</field>
            <!-- Architecture : contenu XML de la vue -->
            <field name="arch" type="xml">
                <tree string="Auteurs">
                    <field name="name" />
                    <field name="pseudonym" />
                    <field name="nationality" />
                    <field name="book_count" />
                </tree>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- VUE RECHERCHE AUTEUR                         -->
        <!-- ============================================ -->
        <record id="view_library_author_search" model="ir.ui.view">
            <field name="name">library.author.search</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="nationality" />
                    <field name="pseudonym" />
                </search>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- VUE KANBAN AUTEUR                            -->
        <!-- ============================================ -->
        <record id="view_library_author_kanban" model="ir.ui.view">
            <field name="name">library.author.kanban</field>
            <field name="model">library.author</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name" />
                    <field name="pseudonym" />
                    <field name="nationality" />
                    <field name="book_count" />

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click library_kanban_card">
                                <div class="oe_kanban_details">

                                    <!-- Titre -->
                                    <div class="library_kanban_title">
                                        <field name="name" />
                                    </div>

                                    <!-- Pseudonyme -->
                                    <div class="library_kanban_line">
                                        <span class="library_kanban_label">Pseudonyme :</span>
                                        <span class="library_kanban_value">
                                            <field name="pseudonym" />
                                        </span>
                                    </div>

                                    <!-- Nationalité -->
                                    <div class="library_kanban_line">
                                        <span class="library_kanban_label">Nationalité :</span>
                                        <span class="library_kanban_value">
                                            <field name="nationality" />
                                        </span>
                                    </div>

                                    <!-- Footer avec badge -->
                                    <div class="library_kanban_footer">
                                        <span class="library_kanban_badge">
                                            <field name="book_count" /> livres </span>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- ACTION                                       -->
        <!-- ============================================ -->
        <record id="action_library_author" model="ir.actions.act_window">
            <field name="name">Auteurs</field>
            <field name="res_model">library.author</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>

    </data>
</odoo>