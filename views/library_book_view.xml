<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================ -->
        <!-- VUE FORMULAIRE LIVRE                         -->
        <!-- ============================================ -->
        <record id="view_library_book_form" model="ir.ui.view">
            <field name="name">library.book.form</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <form string="Livre">

                    <!-- Barre de boutons + état -->
                    <header>
                        <button name="action_publish"
                            type="object"
                            icon="fa-check"
                            string="Publier"
                            class="oe_highlight"
                            states="draft"
                            confirm="Êtes-vous sûr de vouloir publier ce livre ?"
                        />
                        <!-- Emprunter : passe le livre en état "emprunté" et "indisponible". -->
                        <button name="action_borrow"
                            type="object"
                            icon="fa-book"
                            string="Emprunter"
                            states="published"
                            confirm="Êtes-vous sûr de vouloir emprunter ce livre ?"
                        />
                        <!-- retounéée une livre passe le livre en disponible et en états publié -->
                        <button name="action_return" type="object"
                            string="Retourner"
                            icon="fa-undo"
                            states="borrowed"
                            confirm="Êtes-vous sûr de vouloir retourner ce livre ?"
                        />
                        <!-- seulement les livres publier peuvent revenir on brouillon 
                         et passe en unavaible -->
                        <button name="action_draft" type="object"
                            string="Remettre en brouillon"
                            icon="fa-times"
                            states="published"
                            confirm="Êtes-vous sûr de vouloir remettre ce livre en brouillon ?"
                        />
                        <field name="state" widget="statusbar" />
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="ref_livre" readonly="1" />
                                <field name="name" />
                                <field name="isbn" />
                                <field name="author_id" />
                                <field name="author_nationality" />
                                <field name="category_name" />
                            </group>
                            <group>
                                <field name="pages" />
                                <field name="publication_date" />
                                <field name="availability" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- VUE LISTE (TREE) LIVRE                       -->
        <!-- ============================================ -->
        <record id="view_library_book_tree" model="ir.ui.view">
            <field name="name">library.book.tree</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <tree string="Livres"
                    decoration-muted="state == 'draft'"
                    decoration-success="state == 'published'"
                    decoration-warning="state == 'borrowed'">
                    <field name="ref_livre" />
                    <field name="name" />
                    <field name="author_id" />
                    <field name="category_id" />
                    <field name="pages" />
                    <field name="state" />

                    <button name="action_publish"
                        type="object"
                        icon="fa-check"
                        string="Publier"
                        class="oe_highlight"
                        states="draft"
                        confirm="Êtes-vous sûr de vouloir publier ce livre ?" />
                    <button name="action_borrow"
                        type="object"
                        icon="fa-book"
                        string="Emprunter"
                        states="published"
                        confirm="Êtes-vous sûr de vouloir emprunter ce livre ?" />
                    <button name="action_return"
                        type="object"
                        icon="fa-undo"
                        string="Retourner"
                        states="borrowed"
                        confirm="Êtes-vous sûr de vouloir retourner ce livre ?" />
                </tree>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- VUE KANBAN LIVRE                             -->
        <!-- ============================================ -->
        <record id="view_library_book_kanban" model="ir.ui.view">
            <field name="name">library.book.kanban</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <kanban>
                    <!-- Champs utilisés dans le template -->
                    <field name="ref_livre" />
                    <field name="name" />
                    <field name="author_id" />
                    <field name="category_id" />
                    <field name="pages" />
                    <field name="state" />

                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click library_book_kanban_card">
                                <div class="oe_kanban_details">

                                    <!-- Titre du livre -->
                                    <div class="library_book_kanban_title">
                                        <field name="name" />
                                    </div>

                                    <!-- Auteur -->
                                    <div class="library_book_kanban_line">
                                        <span class="library_book_kanban_label">Auteur :</span>
                                        <span class="library_book_kanban_value">
                                            <field name="author_id" />
                                        </span>
                                    </div>

                                    <!-- Catégorie -->
                                    <div class="library_book_kanban_line">
                                        <span class="library_book_kanban_label">Catégorie :</span>
                                        <span class="library_book_kanban_value">
                                            <field name="category_id" />
                                        </span>
                                    </div>

                                    <!-- Pages -->
                                    <div class="library_book_kanban_line">
                                        <span class="library_book_kanban_label">Pages :</span>
                                        <span class="library_book_kanban_value">
                                            <field name="pages" />
                                        </span>
                                    </div>

                                    <!-- État -->
                                    <div class="library_book_kanban_line">
                                        <span class="library_book_kanban_label">État :</span>
                                        <span class="library_book_kanban_value">
                                            <field name="state" />
                                        </span>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- ============================================ -->
        <!-- VUE RECHERCHE LIVRE                          -->
        <!-- ============================================ -->
        <record id="view_library_book_search" model="ir.ui.view">
            <field name="name">library.book.search</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <search>
                    <!-- -->
                    <field name="name" />
                    <field name="author_id" />
                    <field name="ref_livre" />
                    <!-- les filtres -->
                    <!-- filtre selon l'états du libre -->
                    <!-- afficher seulemetn les livres en broullions -->
                    <filter name="filter_draft" string="Brouillons"
                        domain="[('state', '=', 'draft')]" />
                    <!-- afficher seulement les livres qui son publiés -->
                    <filter name="filter_published" string="Publiés"
                        domain="[('state', '=', 'published')]" />
                    <!-- afficher seulement les livres qui son empruntés -->
                    <filter name="filter_borrowed" string="Empruntés"
                        domain="[('state', '=', 'borrowed')]" />
                    <separator />

                    <!-- afficher seulement les livres qui sont disponibles -->
                    <filter name="filter_available" string="Disponibles"
                        domain="[('availability', '=', 'available')]" />
                    <filter name="filter_unavailable" string="Indisponibles"
                        domain="[('availability', '=', 'unavailable')]" />
                    <separator />
                    <!-- n'affiche que le livres avec le reférence rechercher LIV-XXX-->
                    <filter name="filter_no_ref" string="Sans référence"
                        domain="[('ref_livre', '=', False)]" />

                    <separator />
                    <!-- FILTRE AVANCEE -->
                    <!-- flitre pour avoir les libre plus de 500 pages -->
                    <filter name="filter_more_500_pages" string="plus de 500 pages"
                        domain="[('pages', '>', 500)]" />
                    <!-- filtre pour les livre recent du 21ème siècles -->
                    <filter name="filter_recent_21st_century" string="Récent (21ème siècle)"
                        domain="[('publication_date', '>=', '2000-01-01')]" />
                    <!-- filtre pour afficher les anciens livres -->
                    <filter name="filter_old_books" string="Anciens livres"
                        domain="[('publication_date', '&lt;', '2000-01-01')]" />

                    <!-- REGROUPEMENT   -->

                    <group expand="0" string="Grouper par">
                        <!-- Grouper les données  selon leur état chacun (disponible, emprunté,
                        etc.) -->
                        <filter name="group_by_state" string="État"
                            context="{'group_by': 'state'}" />
                        <!-- Grouper les données  selon leur auteur -->
                        <filter name="group_by_author" string="Auteur"
                            context="{'group_by': 'author_id'}" />
                        <!-- Grouper les données  selon leur catégorie -->
                        <filter name="group_by_category" string="Catégorie"
                            context="{'group_by': 'category_id'}" />
                        <!-- groupement par disponibilité -->

                        <filter name="group_by_availability" string="Disponibilité"
                            context="{'group_by': 'availability'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================ -->
        <!-- ACTION                                       -->
        <!-- ============================================ -->
        <record id="action_library_book" model="ir.actions.act_window">
            <field name="name">Livres</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">tree,kanban,form</field>
        </record>

    </data>
</odoo>