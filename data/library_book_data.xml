<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- AUTEURS (d'abord, car référencés par les livres) -->
        <!-- ============================================ -->

        <record id="author_victor_hugo" model="library.author">
            <field name="name">Victor Hugo</field>
            <field name="nationality">Française</field>
            <field name="birth_date">1802-02-26</field>
        </record>

        <record id="author_george_orwell" model="library.author">
            <field name="name">George Orwell</field>
            <field name="nationality">Britannique</field>
            <field name="birth_date">1903-06-25</field>
        </record>

        <!-- ============================================ -->
        <!-- CATÉGORIES                                    -->
        <!-- ============================================ -->

        <record id="category_roman" model="library.category">
            <field name="name">Roman</field>
            <field name="description">Œuvres romanesques</field>
        </record>

        <record id="category_science_fiction" model="library.category">
            <field name="name">Science-Fiction</field>
            <field name="description">Anticipation, dystopie</field>
        </record>

        <!-- ============================================ -->
        <!-- LIVRES                                        -->
        <!-- ============================================ -->

        <record id="book_les_miserables" model="library.book">
            <field name="name">Les Misérables</field>
            <field name="isbn">978-2-07-040850-4</field>
            <field name="author_id" ref="author_victor_hugo"/>
            <field name="category_id" ref="category_roman"/>
            <field name="pages">1500</field>
            <field name="publication_date">1862-01-01</field>
            <field name="state">published</field>
        </record>

        <record id="book_1984" model="library.book">
            <field name="name">1984</field>
            <field name="isbn">978-2-07-036822-8</field>
            <field name="author_id" ref="author_george_orwell"/>
            <field name="category_id" ref="category_science_fiction"/>
            <field name="pages">376</field>
            <field name="publication_date">1949-06-08</field>
            <field name="state">published</field>
        </record>

    </data>
</odoo>