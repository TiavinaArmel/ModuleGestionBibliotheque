<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">


        <!-- ============================================ -->
        <!-- LIVRES (les livre sont placer dernièrement) 
         une livre doit avoir des champs : 
         nom, isbn, auteur, catégorie,  nombre de pages, date de publication, état -->
        <!-- ============================================ -->

        <record id="book_les_miserables" model="library.book">
            <field name="name">Les Misérables</field>
            <field name="isbn">978-2-07-040850-4</field>
            <field name="author_id" ref="author_victor_hugo" />
            <field name="category_id" ref="category_roman" />
            <field name="pages">1500</field>
            <field name="publication_date">1862-01-01</field>
            <field name="state">published</field>
        </record>

        <record id="book_1984" model="library.book">
            <field name="name">1984</field>
            <field name="isbn">978-2-07-036822-8</field>
            <field name="author_id" ref="author_george_orwell" />
            <field name="category_id" ref="category_science_fiction" />
            <field name="pages">376</field>
            <field name="publication_date">1949-06-08</field>
            <field name="state">published</field>
        </record>

    </data>
</odoo>