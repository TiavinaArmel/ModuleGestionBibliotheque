<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!-- AUTEURS                                       -->
        <!-- ============================================ -->
        <!--
            Ce fichier contient UNIQUEMENT les auteurs.
            doit être placée avant les livres, car les livres font référence aux auteurs.
            Les catégories sont dans library_category_data.xml.
            Les livres sont dans library_book_data.xml.
        -->

        <!-- ============================================ -->
        <!-- AUTEUR N : [Nom court pour commentaire]      -->
        <!-- ============================================ -->
        <!-- 

    <record id="author_[nom_avec_underscores]" model="library.author">
        <field name="name">[Nom complet de l'auteur]</field>
        <field name="pseudonym">[Pseudonyme]</field>
